{
  "components": {
    "schemas": {
      "ConfirmResponse": {
        "properties": {
          "next_action": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Action"
          },
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "payment_id",
          "status"
        ],
        "title": "ConfirmResponse",
        "type": "object"
      },
      "CreatePaymentIntent": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "const": "INR",
            "title": "Currency",
            "type": "string"
          },
          "payee_vpa": {
            "anyOf": [
              {
                "maxLength": 130,
                "minLength": 4,
                "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payee Vpa"
          },
          "payer_vpa": {
            "anyOf": [
              {
                "maxLength": 130,
                "minLength": 4,
                "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer Vpa"
          },
          "payment_method_token": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 8,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method Token"
          },
          "payment_method_type": {
            "enum": [
              "card",
              "upi"
            ],
            "title": "Payment Method Type",
            "type": "string"
          }
        },
        "required": [
          "amount_minor",
          "currency",
          "payment_method_type"
        ],
        "title": "CreatePaymentIntent",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PaymentIntentResponse": {
        "properties": {
          "amount_minor": {
            "title": "Amount Minor",
            "type": "integer"
          },
          "created_at": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Created At"
          },
          "currency": {
            "title": "Currency",
            "type": "string"
          },
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          },
          "payment_method_type": {
            "title": "Payment Method Type",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "payment_id",
          "amount_minor",
          "currency",
          "payment_method_type",
          "status"
        ],
        "title": "PaymentIntentResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
