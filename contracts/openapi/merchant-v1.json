            "title": "Reason Codes"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "payment_id",
          "status"
        ],
        "title": "ConfirmResponse",
        "type": "object"
      },
      "CreatePaymentIntent": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "exclusiveMinimum": 0.0,
            "maximum": 9007199254740991.0,
            "title": "Amount Minor",
            "type": "integer"
          },
          "currency": {
            "const": "INR",
            "title": "Currency",
            "type": "string"
          },
          "payee_vpa": {
            "anyOf": [
              {
                "maxLength": 130,
                "minLength": 4,
                "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payee Vpa"
          },
          "payer_vpa": {
            "anyOf": [
              {
                "maxLength": 130,
                "minLength": 4,
                "pattern": "^[A-Za-z0-9._-]+@[A-Za-z0-9.-]+$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payer Vpa"
          },
          "payment_method_token": {
            "anyOf": [
              {
                "maxLength": 200,
                "minLength": 8,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Payment Method Token"
          },
          "payment_method_type": {
            "enum": [
              "card",
              "upi"
            ],
            "title": "Payment Method Type",
            "type": "string"
          },
          "risk_context": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RiskContext"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "amount_minor",
          "currency",
          "payment_method_type"
        ],
        "title": "CreatePaymentIntent",
        "type": "object"
      },
      "CreateRefund": {
        "additionalProperties": false,
        "properties": {
          "amount_minor": {
            "anyOf": [
              {
                "exclusiveMinimum": 0.0,
                "maximum": 9007199254740991.0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Amount Minor"
          },
          "payment_id": {
            "format": "uuid",
            "title": "Payment Id",
            "type": "string"
          },
          "reason": {
