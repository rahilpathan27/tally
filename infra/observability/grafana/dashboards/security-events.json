{
  "uid": "tally-security-events",
  "title": "Security Events",
  "tags": [
    "tally"
  ],
  "timezone": "Asia/Kolkata",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Auth events / 10m",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (event) (increase(tally_auth_events_total[10m]))",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "Rate-limited requests / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(tally_rate_limited_total[5m])",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "title": "SSRF blocks (1h)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tally_ssrf_blocked_total[1h])",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "Webhook results / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (result) (rate(tally_webhook_deliveries_total[5m]))",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 5,
      "title": "Webhook backlog",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tally_webhook_backlog",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 6,
      "title": "Outbox backlog",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tally_outbox_unpublished",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    }
  ]
}
