{
  "uid": "tally-ledger-health",
  "title": "Ledger Health",
  "tags": [
    "tally"
  ],
  "timezone": "Asia/Kolkata",
  "refresh": "30s",
  "schemaVersion": 39,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "Integrity checks (1 = ok)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "tally_ledger_integrity_ok",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 2,
      "title": "Postings / s by result",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (operation, result) (rate(tally_ledger_posts_total[5m]))",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 3,
      "title": "Posting p99 latency",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.99, sum by (le, operation) (rate(tally_ledger_post_duration_seconds_bucket[5m])))",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    },
    {
      "id": 4,
      "title": "Verifier runs (15m)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "increase(tally_ledger_integrity_runs_total[15m])",
          "datasource": {
            "uid": "prometheus"
          }
        }
      ],
      "options": {}
    }
  ]
}
